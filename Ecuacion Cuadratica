#include <iostream>
#include <cmath>
using namespace std;

int main()
{
    float a, b, c;
    cout<<"Ingrese el valor a: ";
    cin>>a;
    cout<<"Ingrese el valor b: ";
    cin>>b;
    cout<<"Ingrese el valor c: ";
    cin>>c;

    double x1, x2;
    x1 = (-b + sqrt(b * b - 4 * a * c)) / (2 * a);
    x2 = (-b - sqrt(b * b - 4 * a * c)) / (2 * a);

    cout<<"La primera raiz es: "<<x1<<endl;
    cout<<"La segunda raiz es: "<<x2<<endl;

    return 0;
}
